venv/
__pycache__/
*.pyc
trained_models/
datasets/
.env
# Recordings, thumbnails and the session database: hundreds of
# megabytes, and regenerable. The hand-corrected evaluation labels are
# the exception -- they are the ground truth the measurements in the
# README are quoted from, and a few kilobytes each.
data/*
!data/eval/
data/eval/*
!data/eval/*.csv
*.part

# The desktop build. node_modules is a hundred megabytes of Electron,
# and dist/ is the executable it produces -- both are regenerable from
# desktop/package.json with two commands, and neither belongs in a
# repository this one is cloned from.
desktop/node_modules/
desktop/dist/
